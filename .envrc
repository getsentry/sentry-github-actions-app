# shellcheck shell=bash
missing() {
    ! command -v "$1" >/dev/null 2>&1
}

set -e

if missing uv; then
    echo >&2 "You're missing uv. Install it with brew install uv"
    return 1
fi
# Convenient if you want secrets to load (e.g. personal token, Github webhook secret) or override values from env.development
dotenv_if_exists .env

# Creates .venv and installs the locked dependencies. It's fast when nothing changed.
uv sync --quiet
source .venv/bin/activate
# If installed, it executes very fast
pre-commit install >/dev/null

# https://github.com/direnv/direnv/wiki/PS1
unset PS1
